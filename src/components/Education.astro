---
import SectionHeading from './SectionHeading.astro';
import { certifications, education } from '../data/resume';
---

<section id="education" class="px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <SectionHeading index="05" title="Education & Certifications" command="cat credentials.log" />

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="reveal panel p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="font-mono text-base font-bold text-ink sm:text-lg">{education.institution}</h3>
          <span class="font-mono text-xs text-term">{education.period}</span>
        </div>
        <p class="mt-2 font-mono text-sm text-cyan">{education.degree}</p>
        <ul class="mt-5 space-y-2.5">
          {
            education.highlights.map((highlight) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span class="mt-0.5 font-mono text-term-dim select-none" aria-hidden="true">
                  +
                </span>
                <span>{highlight}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        {
          certifications.map((cert) => (
            <div class="panel flex flex-col justify-between p-5 transition-colors hover:border-term/50">
              <p class="font-mono text-xs tracking-wider text-term uppercase">{cert.issuer}</p>
              <p class="mt-3 text-sm leading-snug text-ink">{cert.name}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
