---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/resume';
---

<section id="work" class="px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <SectionHeading index="04" title="Selected Work" command="ls ./impact --detail" />

    <div class="grid gap-5 md:grid-cols-2">
      {
        projects.map((project) => (
          <article class="reveal panel group flex flex-col p-6 transition-colors duration-300 hover:border-term/50">
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-mono text-base font-medium text-ink transition-colors group-hover:text-term sm:text-lg">
                {project.title}
              </h3>
              <span class="mt-1 font-mono text-xs text-faint whitespace-nowrap">
                {project.id}
              </span>
            </div>

            <p class="mt-1 font-mono text-xs text-term-dim">{project.context}</p>

            <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">{project.description}</p>

            <p class="mt-5 border-t border-edge pt-4 font-mono text-sm text-term">
              <span class="text-faint">↳</span> {project.metric}
            </p>

            <ul class="mt-4 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
