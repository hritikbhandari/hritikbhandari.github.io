---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/resume';
---

<section id="experience" class="px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <SectionHeading index="03" title="Experience" command="git log --author='Hritik Bhandari'" />

    <div class="space-y-14">
      {
        experience.map((company) => (
          <div class="reveal">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-mono text-xl font-bold text-ink sm:text-2xl">{company.company}</h3>
              <span class="font-mono text-xs text-term">{company.period}</span>
            </div>
            {company.note && <p class="mt-2 text-sm text-faint italic">{company.note}</p>}

            <ol class="mt-7 space-y-9 border-l border-edge pl-6 sm:pl-8">
              {company.roles.map((role) => (
                <li class="relative">
                  <span
                    class="absolute top-2 -left-[1.6rem] h-2.5 w-2.5 rounded-full border border-term bg-void sm:-left-[2.1rem]"
                    aria-hidden="true"
                  />
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h4 class="font-mono text-base font-medium text-cyan sm:text-lg">
                      {role.title}
                    </h4>
                    <span class="font-mono text-xs text-faint">{role.period}</span>
                  </div>
                  <ul class="mt-3 space-y-2.5">
                    {role.bullets.map((bullet) => (
                      <li class="flex gap-3 text-sm leading-relaxed text-muted">
                        <span class="mt-0.5 font-mono text-term-dim select-none" aria-hidden="true">
                          +
                        </span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>
